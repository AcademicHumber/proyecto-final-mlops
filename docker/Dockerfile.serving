# API de inferencia. No contiene el modelo: lo descarga del servidor MLflow por alias.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /app

COPY docker/requirements-serving.txt .
RUN pip install --no-cache-dir -r requirements-serving.txt

COPY serving/ serving/

ENV MLFLOW_TRACKING_URI=http://mlflow:5000 \
    MODEL_URI=models:/adult-income-classifier@production

EXPOSE 8000
CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
