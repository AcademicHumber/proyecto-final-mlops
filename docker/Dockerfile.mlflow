# Servidor MLflow: base de datos SQLite + artefactos servidos por HTTP.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /app

COPY docker/requirements-mlflow.txt .
RUN pip install --no-cache-dir -r requirements-mlflow.txt

# /mlflow es el punto de montaje del volumen persistente (mlflow.db + mlartifacts)
VOLUME /mlflow
EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", "--port", "5000", "--workers", "1", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/mlartifacts", \
     "--serve-artifacts", \
     "--allowed-hosts", "mlflow,mlflow:5000,mlflow.default.svc.cluster.local:5000,localhost,localhost:5000,127.0.0.1:5000"]
